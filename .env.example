# LEG-Platform – configuration template
# Copy to .env for each instance (one instance per municipality). Never commit .env.

# Django

DJANGO_SETTINGS_MODULE=
DJANGO_SECRET_KEY=
# DJANGO_DEBUG=True is only allowed with APP_ENV=local.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=

# Note: the Microsoft Graph client secret stored in the admin is encrypted with a key
# derived from DJANGO_SECRET_KEY. When rotating DJANGO_SECRET_KEY, keep the old key as a
# fallback until the secret has been re-encrypted; otherwise enter the secret again.

# Environment: local, stage, production
# A missing or unknown value prevents the application from starting.

APP_ENV=

# MySQL

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Initial system administrator setup (manual, one-time)
# Read only by the setup management command, which runs only while no system administrator exists.
# The command asks for the initial password interactively; never store a password in this file.

BOOTSTRAP_SYSTEM_ADMIN_EMAIL=

# Email delivery mode
# console:   output to the console or test output only (default; not allowed with APP_ENV=production)
# allowlist: delivery via Microsoft Graph, restricted to EMAIL_ALLOWED_RECIPIENTS (e.g. stage;
#            not allowed with APP_ENV=production)
# graph:     unrestricted delivery via Microsoft Graph; only allowed with APP_ENV=production
# The Microsoft Graph configuration itself is maintained in the Django admin.

EMAIL_MODE=console
EMAIL_ALLOWED_RECIPIENTS=

# Optional: add further environment variables only
# when the concrete implementation requires them.
