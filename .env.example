# LEG-Platform – configuration template
# Copy to .env for each instance (one instance per municipality). Never commit .env.
# The settings read these values from the process environment only (docs/DECISIONS.md, D-027);
# they are validated at startup by leg_platform/environment.py, and invalid or unsafe values
# prevent the application from starting.
# Lists are comma-separated; spaces around items are ignored.

# Django

DJANGO_SETTINGS_MODULE=leg_platform.settings
# Required. A random value with at least 50 characters outside APP_ENV=local, e.g. from
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Optional. Previous secret keys, kept during a key rotation (comma-separated).
DJANGO_SECRET_KEY_FALLBACKS=
# True or False. DJANGO_DEBUG=True is only allowed with APP_ENV=local.
DJANGO_DEBUG=False
# Exact host names of the application (not of the instance's website); no wildcards.
# Required outside APP_ENV=local.
DJANGO_ALLOWED_HOSTS=
# Optional. Only needed for origins other than the application's own host, e.g.
# https://host[:port]. Never the instance's website and never a wildcard.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Planned (D-006, not implemented yet): the Microsoft Graph client secret will be maintained
# in the admin and encrypted with a key derived from DJANGO_SECRET_KEY. Once that exists,
# keep the old key as a fallback when rotating DJANGO_SECRET_KEY until the secret has been
# re-encrypted; otherwise the secret must be entered again.

# HTTPS (applies to APP_ENV=stage and APP_ENV=production)
# Optional. Only behind a reverse proxy that sets this header and removes it from client
# requests, in the form HTTP_<HEADER>,<value>, e.g. HTTP_X_FORWARDED_PROTO,https.
# Setting it without such a proxy allows clients to pretend that a request used HTTPS.
DJANGO_SECURE_PROXY_SSL_HEADER=
# Trusted reverse proxies in front of Django for login IP tracking. Default 0 trusts no
# forwarded client-IP headers. Set the exact proxy count only when each proxy validates or
# overwrites forwarded headers; see docs/SECURITY.md, section 3.
AXES_IPWARE_PROXY_COUNT=0
# Optional. Duration of HTTP Strict Transport Security in seconds (default: 31536000, one
# year). Use a small value such as 3600 while testing a new installation.
DJANGO_SECURE_HSTS_SECONDS=
# Optional. True or False (default: False). Adds includeSubDomains to the HSTS header, so that
# browsers also require HTTPS for every host below the application's host name. Enable it
# only if all those hosts support HTTPS; the policy stays in browsers for
# DJANGO_SECURE_HSTS_SECONDS. HSTS preload is never set (docs/DECISIONS.md, D-028).
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# Environment: local, stage, production
# A missing or unknown value prevents the application from starting.

APP_ENV=

# Database: MariaDB (docs/DECISIONS.md, D-002, D-030), through Django's MySQL backend

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Initial system administrator setup (manual, one-time)
# Read only by the setup management command, which runs only while no system administrator exists:
#   python manage.py setup_initial_administrator
# The command asks for the initial password interactively; never store a password in this file.
# At the first login the password must be changed and two-factor authentication set up (D-005).

BOOTSTRAP_SYSTEM_ADMIN_EMAIL=

# Security log retention in days (docs/SECURITY.md, section 10; D-018, D-041)
# Optional. The defaults are also the minimum; a lower value prevents the start.
# SECURITY_LOG_RETENTION_DAYS: usual entries (default and minimum 30)
# SECURITY_LOG_LONG_RETENTION_DAYS: changes of rights and roles, resets of the second factor,
# emergency commands and similar entries (default and minimum 365)
SECURITY_LOG_RETENTION_DAYS=
SECURITY_LOG_LONG_RETENTION_DAYS=

# Email delivery mode (docs/ARCHITECTURE.md, "Email")
# console:   output to the console or test output only; only allowed with APP_ENV=local,
#            where it is the default
# allowlist: delivery via Microsoft Graph, restricted to EMAIL_ALLOWED_RECIPIENTS; required
#            with APP_ENV=stage, allowed with APP_ENV=local. Locally only with a dedicated
#            development app registration and sender mailbox, never with the credentials
#            of stage or production.
# graph:     unrestricted delivery via Microsoft Graph; required with APP_ENV=production
# Outside APP_ENV=local, EMAIL_MODE must be set; a missing or unsuitable value prevents the
# application from starting.
# The Microsoft Graph configuration itself will be maintained in the Django admin (D-006).
# Delivery via Microsoft Graph is not implemented yet: in the modes allowlist and graph,
# every attempt to send an email currently fails with an error.

EMAIL_MODE=console
# Comma-separated addresses for EMAIL_MODE=allowlist; required in that mode. Each entry must
# be one complete address (no wildcards, no domain-only entries). On a development machine,
# set them only as a user environment variable; never write real addresses into the
# repository. Debug pages and error reports mask this value.
EMAIL_ALLOWED_RECIPIENTS=

# Instance configuration (docs/PROJECT.md, "Instance configuration"; docs/DECISIONS.md, D-013)
# Values of one instance; never hard-code them in the code.
# Optional. Name of the instance shown in pages and email subjects (at most 100 characters).
INSTANCE_NAME=
# Canonical origin of the application, e.g. https://portal.example.org (an origin, no path).
# Links in emails are built from it, never from the request. Its host must be in
# DJANGO_ALLOWED_HOSTS. Required outside APP_ENV=local; locally it defaults to
# http://127.0.0.1:8000.
INSTANCE_BASE_URL=
# Absolute https:// URL of the instance's privacy notice, linked at registration and on all
# pages accessible without login (D-022). Required outside APP_ENV=local.
INSTANCE_PRIVACY_URL=
# Optional. Absolute https:// URL of the instance's website, linked from the login page (D-025).
INSTANCE_WEBSITE_URL=
# Optional. Sender address of outgoing email, e.g. noreply@example.org. Default:
# noreply@<host of INSTANCE_BASE_URL>. It must be an address the sending service may use. The
# emails do not invite a reply. SPF, DKIM and DMARC of its domain are set up by the operator
# (docs/INSTALLATION.md).
EMAIL_SENDER_ADDRESS=

# Optional: add further environment variables only
# when the concrete implementation requires them.
