# LEG-Platform – configuration template
# Copy to .env for each instance (one instance per municipality). Never commit .env.
# The settings read these values from the process environment only (docs/DECISIONS.md, D-027);
# they are validated at startup by leg_platform/environment.py, and invalid or unsafe values
# prevent the application from starting.
# Lists are comma-separated; spaces around items are ignored.

# Django

DJANGO_SETTINGS_MODULE=leg_platform.settings
# Required. A random value with at least 50 characters outside APP_ENV=local, e.g. from
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Optional. Previous secret keys, kept during a key rotation (comma-separated).
DJANGO_SECRET_KEY_FALLBACKS=
# True or False. DJANGO_DEBUG=True is only allowed with APP_ENV=local.
DJANGO_DEBUG=False
# Exact host names of the application (not of the instance's website); no wildcards.
# Required outside APP_ENV=local.
DJANGO_ALLOWED_HOSTS=
# Optional. Only needed for origins other than the application's own host, e.g.
# https://host[:port]. Never the instance's website and never a wildcard.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Microsoft Graph (D-006): the certificate and its
# private key are entered in the Django admin, not in this file. The private key is encrypted
# with a key derived from DJANGO_SECRET_KEY. When rotating DJANGO_SECRET_KEY, keep the old key in
# DJANGO_SECRET_KEY_FALLBACKS until the private key has been encrypted again (this happens when
# it is used); otherwise the certificate and private key must be uploaded again.

# HTTPS (applies to APP_ENV=stage and APP_ENV=production)
# Optional. Only behind a reverse proxy that sets this header and removes it from client
# requests, in the form HTTP_<HEADER>,<value>, e.g. HTTP_X_FORWARDED_PROTO,https.
# Setting it without such a proxy allows clients to pretend that a request used HTTPS.
DJANGO_SECURE_PROXY_SSL_HEADER=
# Trusted reverse proxies in front of Django for login IP tracking. Default 0 trusts no
# forwarded client-IP headers. Set the exact proxy count only when each proxy validates or
# overwrites forwarded headers; see docs/SECURITY.md, section 3.
AXES_IPWARE_PROXY_COUNT=0
# Optional. Duration of HTTP Strict Transport Security in seconds (default: 31536000, one
# year). Use a small value such as 3600 while testing a new installation.
DJANGO_SECURE_HSTS_SECONDS=
# Optional. True or False (default: False). Adds includeSubDomains to the HSTS header, so that
# browsers also require HTTPS for every host below the application's host name. Enable it
# only if all those hosts support HTTPS; the policy stays in browsers for
# DJANGO_SECURE_HSTS_SECONDS. HSTS preload is never set (docs/DECISIONS.md, D-028).
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# Environment: local, stage, production
# stage is only the label of the instance role: it behaves exactly like production (D-070).
# A missing or unknown value prevents the application from starting.

APP_ENV=

# Database: MariaDB (docs/DECISIONS.md, D-002, D-030), through Django's MySQL backend

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# The address directory (D-033, D-049, D-050, D-075, D-090): an own SQLite file next to the database. It
# is public data, not part of any backup. The web application itself downloads and imports it, in a
# background thread, when an administrator presses the button or when the automatic refresh is due
# (no worker, no cron job needed; `manage.py process_address_imports` stays as an alternative).
# ADDRESS_DIRECTORY_FILE is optional: an absolute path of a file outside the repository, without
# control characters. Default outside APP_ENV=local: /var/lib/leg-platform/address-directory.sqlite3
# (the folder comes from StateDirectory=leg-platform of the systemd units). Default with
# APP_ENV=local: ~/.leg-platform-dev/address-directory.sqlite3. The folder is created as 0700 and
# the file as 0600 when it is missing.
# ADDRESS_IMPORT_AUTOMATIC (True or False, default True): the daily run of the scheduled tasks
# (manage.py run_scheduled_tasks, task scheduled_address_import) imports the directory once per day
# from the configured time (default 03:00) when it is due: an address was not found (update flag), the
# directory has no building numbers yet, every 90 days, every 24 hours while there is no directory.
# False: only the button (or the worker) updates the directory. The outbound HTTPS connection to
# data.geo.admin.ch must work for the web service and the scheduled tasks.

ADDRESS_DIRECTORY_FILE=
ADDRESS_IMPORT_AUTOMATIC=

# Application log files (D-099). The portal always writes its log to the standard error output
# (journald under systemd). With LOG_DIRECTORY it also writes two bounded, rotating files
# (application.log and security.log, at most 10 MB each plus 5 older files, mode 0600) that a
# system administrator reads and downloads in the administration ("Protokolldateien").
# Optional: an absolute folder outside the repository, without control characters. Default with
# APP_ENV=local: ~/.leg-platform-dev/logs. Default outside local: /var/log/leg-platform (the systemd
# units need LogsDirectory=leg-platform). "off" turns the files off (journald only). A folder that
# cannot be created or written means no files (the log still goes to the standard error output).
# The lines are cleaned of links with tokens, email addresses and IBANs; several processes write
# the same files, so a rotation can reorder or drop old lines but never lets the files grow.

LOG_DIRECTORY=

# Initial system administrator (D-005, D-041, D-076): created automatically at the first start
# Read only by `python manage.py setup_instance` (the systemd unit leg-setup.service runs it on
# every start; locally you run it by hand). It creates the account only while NO system
# administrator exists. Set both variables before the first start:
#   BOOTSTRAP_SYSTEM_ADMIN_EMAIL     the address of the first system administrator
#   BOOTSTRAP_SYSTEM_ADMIN_PASSWORD  the initial password: at least 15 characters (the same rules
#                                    as every password), written as a plain value without quotes
#                                    or a trailing space. It is a SECRET: this file must be
#                                    readable only by root (mode 0600), and debug pages and error
#                                    reports mask it.
# At the first login the password must be changed at once and two-factor authentication must be
# set up before anything else is possible.
# REMOVE BOOTSTRAP_SYSTEM_ADMIN_PASSWORD from this file after the first login (the initial password
# stops being valid when it is changed, and as soon as a system administrator exists the variable is
# ignored; every start prints a reminder while it is still set). The alternative without a password
# in a file: leave it unset, run `python manage.py setup_initial_administrator` once in a terminal
# (it asks for the password) with only the email variable set for that one command.

BOOTSTRAP_SYSTEM_ADMIN_EMAIL=
BOOTSTRAP_SYSTEM_ADMIN_PASSWORD=

# Security log retention in days (docs/SECURITY.md, section 10; D-018, D-041)
# Optional. The defaults are also the minimum; a lower value prevents the start.
# SECURITY_LOG_RETENTION_DAYS: usual entries (default and minimum 30)
# SECURITY_LOG_LONG_RETENTION_DAYS: changes of rights and roles, resets of the second factor,
# emergency commands and similar entries (default and minimum 365)
SECURITY_LOG_RETENTION_DAYS=
SECURITY_LOG_LONG_RETENTION_DAYS=

# Email delivery mode (docs/ARCHITECTURE.md, "Email")
# console: output to the console or test output only; only with APP_ENV=local, where it is the default
# graph:   unrestricted delivery via Microsoft Graph; required with APP_ENV=stage and APP_ENV=production
#          (D-070), refused with APP_ENV=local
# Outside APP_ENV=local, EMAIL_MODE must be set; a missing or unsuitable value prevents the
# application from starting. The Microsoft Graph configuration, the sender of emails and the address that
# receives the messages of the contact form are maintained in the Django admin (D-006, D-116).
# The variables EMAIL_ALLOWED_RECIPIENTS, EMAIL_SENDER_ADDRESS, CONTACT_EMAIL_ADDRESS and INSTANCE_BASE_URL
# are no longer read: a value left in the environment refuses the start (D-116).

EMAIL_MODE=console

# Instance configuration (docs/PROJECT.md, "Instance configuration"; docs/DECISIONS.md, D-013)
# Values of one instance; never hard-code them in the code.
# Since D-073 the name, the website, the colours and the logos are also maintained by the
# administrator in the administration ("Portal-Einstellungen"); a value stored there wins, and
# the variables below are the fallback of every field that is left empty there. The uploaded
# logos are stored in the database (no new variable, no file on the server): they belong to the
# database backup. The address of the portal (for links in emails), the sender of emails and the address that
# receives the messages of the contact form are maintained in the administration (D-116). The allowed hosts and
# every other security setting are only here and are shown read only in the administration (D-073).
# Optional. Name of the instance shown in pages and email subjects (at most 100 characters).
INSTANCE_NAME=
# Absolute https:// URL of the instance's privacy notice, linked at registration and on all
# pages accessible without login (D-022). Required outside APP_ENV=local.
INSTANCE_PRIVACY_URL=
# Optional. Absolute https:// URL of the instance's website, linked from the login page (D-025).
INSTANCE_WEBSITE_URL=
# Optional branding. Colours use #RRGGBB; contrast is checked at startup (at least 4.5:1).
# Operators must also check that accents are not red or confusable with status/energy colours.
# Empty values select neutral platform defaults.
INSTANCE_ACCENT_LIGHT=
INSTANCE_ACCENT_TEXT_LIGHT=
INSTANCE_ACCENT_DARK=
INSTANCE_ACCENT_TEXT_DARK=
# Optional background highlight, used only with dark text.
INSTANCE_HIGHLIGHT=
# Set both or neither. Relative static file paths, e.g. instance/logo.svg and
# instance/logo-dark.svg. Only .svg and .png; no external URLs or traversal.
# Operators must check SVG files for scripts and external references before deployment.
# Used only while no logos are uploaded in the administration (D-073).
INSTANCE_LOGO_LIGHT=
INSTANCE_LOGO_DARK=
# Optional existing absolute directory for instance static files outside the repository.
# Logo paths above are relative to it; collectstatic includes it.
INSTANCE_STATIC_DIRECTORY=

# Optional: add further environment variables only
# when the concrete implementation requires them.
