# Based on the official GitHub template Python.gitignore
# (https://github.com/github/gitignore/blob/main/Python.gitignore, checked on 2026-10-09),
# reduced to entries relevant for this project and extended with project-specific entries.
# Deviations from the template:
# - "instance/" (Flask) is not ignored, because it could hide a Django app of that name.
# - "*.mo" is not ignored: compiled translations are committed and CI checks that they match
#   their .po sources (docs/DECISIONS.md, D-034).

# Secrets and local environment

.env
.env.*
!.env.example
.envrc
secrets/
*.secret
*.pem
*.key
*.p12
*.pfx
.pypirc

# Claude Code local settings (personal, not shared)

.claude/settings.local.json

# Byte-compiled / optimized / DLL files

__pycache__/
*.py[codz]
*$py.class

# C extensions

*.so
*.pyd

# Distribution / packaging

.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Installer logs

pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports

htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
*.lcov
.hypothesis/
.pytest_cache/
cover/

# Translations

*.pot

# Django

*.log
# Only the log folder at the root of the repository (the log pages of the administration have templates in
# leg_platform/templates/admin/logs/, which must be tracked; tests/test_packaging.py).
/logs/
local_settings.py
db.sqlite3
db.sqlite3-journal
local.sqlite3
# A copy of the address directory file or a stage dump in the repository root is never committed (the file belongs outside
# the repository, D-075; ADDRESS_DIRECTORY_FILE must point elsewhere).
/address-directory.sqlite3*
/leg-stage-dummy-logins-*.zip
staticfiles/
media/

# Environments

.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.python-version

# Type checkers and linters

.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Editors and operating systems

.vscode/
.idea/
.DS_Store
Thumbs.db

# Local backups and exports

*.sql
*.sql.gz
*.dump
*.bak

# Local template preview for design review (not part of the application)
preview/
