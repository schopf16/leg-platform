"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#, javascript-format
msgid "Choose %s by selecting them and then select the \"Choose\" arrow button."
msgstr "Markieren Sie die gewünschten Einträge (%s) und klicken Sie dann auf den Pfeil «Wählen»."

#, javascript-format
msgid "Remove %s by selecting them and then select the \"Remove\" arrow button."
msgstr "Markieren Sie die Einträge (%s), die Sie entfernen möchten, und klicken Sie dann auf den Pfeil «Entfernen»."

#, javascript-format
msgid "Choose all %s"
msgstr "Alle auswählen (%s)"

#, javascript-format
msgid "Choose selected %s"
msgstr "Markierte auswählen (%s)"

#, javascript-format
msgid "Remove selected %s"
msgstr "Markierte entfernen (%s)"

#, javascript-format
msgid "Remove all %s"
msgstr "Alle entfernen (%s)"
