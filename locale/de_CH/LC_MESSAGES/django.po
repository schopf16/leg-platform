msgid "Did you mean this address?"
msgid_plural "Did you mean one of these addresses?"
msgstr[0] "Meinten Sie diese Adresse?"
msgstr[1] "Meinten Sie eine dieser Adressen?"

msgid "Choose an address to fill in the fields."
msgstr "Wählen Sie eine Adresse aus, um die Felder auszufüllen."

#, python-format
msgid "No street starting with “%(street)s” was found in %(postal_code)s. Choose an address to fill in the fields."
msgstr "In %(postal_code)s wurde keine Strasse gefunden, die mit «%(street)s» beginnt. Wählen Sie eine Adresse aus, um die Felder auszufüllen."

msgid "More addresses match. Keep typing to narrow the list."
msgstr "Es passen weitere Adressen. Geben Sie mehr ein, um die Liste einzugrenzen."

#, python-format
msgid "%(count)s address suggestion available. Press the down arrow key to choose one."
msgid_plural "%(count)s address suggestions available. Press the down arrow key to choose one."
msgstr[0] "%(count)s Adressvorschlag verfügbar. Mit der Pfeiltaste nach unten wählen Sie einen aus."
msgstr[1] "%(count)s Adressvorschläge verfügbar. Mit der Pfeiltaste nach unten wählen Sie einen aus."

#, python-format
msgid "No exact match. %(count)s similar address available. Press the down arrow key to choose it."
msgid_plural "No exact match. %(count)s similar addresses available. Press the down arrow key to choose one."
msgstr[0] "Keine genaue Übereinstimmung. %(count)s ähnliche Adresse verfügbar. Mit der Pfeiltaste nach unten wählen Sie sie aus."
msgstr[1] "Keine genaue Übereinstimmung. %(count)s ähnliche Adressen verfügbar. Mit der Pfeiltaste nach unten wählen Sie eine aus."

#, python-format
msgid "Address filled in: %(address)s."
msgstr "Adresse eingetragen: %(address)s."

