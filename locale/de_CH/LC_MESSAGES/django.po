#, python-format
msgid "Welcome to %(instance_name)s"
msgstr "Willkommen bei %(instance_name)s"

msgid "No account yet?"
msgstr "Noch kein Konto?"

msgid "Register"
msgstr "Registrieren"

msgid "Register as a new user"
msgstr "Neu registrieren"

