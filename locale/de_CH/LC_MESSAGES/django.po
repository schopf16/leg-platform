msgstr "Neutrale Anrede ohne Namen: Der Name eines gelöschten Kontos wird nicht aufbewahrt. Die Vorschau und die Test-E-Mail zeigen dasselbe. Am besten auf einer eigenen Zeile am Anfang."

#: leg_platform/accounts/greeting.py
msgid "Hello"
msgstr "Guten Tag"

#, python-format
msgid "Hello %(name)s"
msgstr "Guten Tag %(name)s"

msgid "Confirm your second email address at %(instance_name)s"
msgstr "Bestätigen Sie Ihre zweite E-Mail-Adresse bei %(instance_name)s"

msgid "An email address change was requested at %(instance_name)s"
msgstr "Bei %(instance_name)s wurde die Änderung einer E-Mail-Adresse beantragt"

