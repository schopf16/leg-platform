#, javascript-format
msgid "Choose %s by selecting them and then select the \"Choose\" arrow button."
msgstr "Scelga %s selezionandoli e poi selezioni il pulsante freccia «Scegli»."

#, javascript-format
msgid "Remove %s by selecting them and then select the \"Remove\" arrow button."
msgstr "Rimuova %s selezionandoli e poi selezioni il pulsante freccia «Rimuovi»."

#, javascript-format
msgid "Choose all %s"
msgstr "Scegli tutti i %s"

#, javascript-format
msgid "Choose selected %s"
msgstr "Scegli i %s selezionati"

#, javascript-format
msgid "Remove selected %s"
msgstr "Rimuovi i %s selezionati"

#, javascript-format
msgid "Remove all %s"
msgstr "Rimuovi tutti i %s"

