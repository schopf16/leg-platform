msgstr "Saisissez le code."

msgid "The code is wrong, expired or was already used. The app shows a new code every 30 seconds: wait for the next one and try again."
msgstr "Le code est erroné, expiré ou a déjà été utilisé. L’application affiche un nouveau code toutes les 30 secondes : attendez le suivant et réessayez."

#, python-format
msgid "Questions or problems: %(contact_url)s"
msgstr "Questions ou problèmes : %(contact_url)s"

msgid "Please check your entries"
msgstr "Veuillez vérifier vos informations"

msgid "Show password"
msgstr "Afficher le mot de passe"

msgid "Hide password"
