msgstr "Trop de demandes d’importation. Veuillez réessayer plus tard."

# D-090: the import of the address directory in the portal itself, its status page and its failure reasons.
msgid "Interrupted"
msgstr "Interrompue"

msgid "Reason"
msgstr "Motif"

msgid "Directory in use"
msgstr "Répertoire utilisé"

msgid "File size"
msgstr "Taille du fichier"

