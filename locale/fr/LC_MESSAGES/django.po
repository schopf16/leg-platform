# Administration, final acceptance (blocks 5c): email text list, start page,
# rights, portal settings.
msgid "Registration"
msgstr "Inscription"

msgid "Login and password"
msgstr "Connexion et mot de passe"

msgid "Account"
msgstr "Compte"

msgid "process"
msgstr "processus"

msgid "Customised"
msgstr "Personnalisé"

msgid "https://www.example.org/privacy"
msgstr "https://www.example.org/privacy"

msgid "https://www.example.org/imprint"
msgstr "https://www.example.org/imprint"

msgid "It must start with https://. It opens in a new tab."
msgstr "Doit commencer par https://. S’ouvre dans un nouvel onglet."

msgid "Saved. The changes are now visible on all pages."
msgstr ""
"Enregistré. Les modifications sont maintenant visibles sur toutes les pages."

msgctxt "right"
msgid "view"
msgstr "voir"

