msgstr[1] "%(days)s jours"
msgstr[2] "%(days)s jours"

msgid "An application that is not submitted yet is deleted."
msgstr "Une demande non encore envoyée est supprimée."

msgid "A submitted application is withdrawn."
msgstr "Une demande envoyée est retirée."

msgid "All details are deleted."
msgstr "Toutes les données sont supprimées."

msgid "Authenticate yourself once more to complete the deletion."
msgstr "Authentifiez-vous une nouvelle fois pour finaliser la suppression."

msgid "Account deleted: withdraw the registration at the grid operator"
msgstr ""
"Compte supprimé : retirer l’inscription auprès du gestionnaire de réseau"

