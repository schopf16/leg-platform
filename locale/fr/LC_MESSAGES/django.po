#, python-format
msgid "You used a recovery code. %(count)d code is left. You can create new codes in your profile."
msgid_plural "You used a recovery code. %(count)d codes are left. You can create new codes in your profile."
msgstr[0] "Vous avez utilisé un code de récupération. Il reste %(count)d code. Vous pouvez créer de nouveaux codes dans votre profil."
msgstr[1] "Vous avez utilisé un code de récupération. Il reste %(count)d codes. Vous pouvez créer de nouveaux codes dans votre profil."
msgstr[2] "Vous avez utilisé un code de récupération. Il reste %(count)d codes. Vous pouvez créer de nouveaux codes dans votre profil."

msgid "You used a recovery code. You have no recovery codes left. Create new codes in your profile."
msgstr "Vous avez utilisé un code de récupération. Il ne vous reste plus de codes de récupération. Créez de nouveaux codes dans votre profil."

msgid "Please tick the box to confirm that you want to delete your account."
msgstr "Veuillez cocher la case pour confirmer que vous souhaitez supprimer votre compte."

msgid "Page not found"
msgstr "Page introuvable"

msgid "Go to the start page"
msgstr "Aller à la page d’accueil"

msgid "Deleted (retention obligation)"
msgstr "Supprimé (obligation de conservation)"

msgid "Account deleted (retention obligation)"
msgstr "Compte supprimé (obligation de conservation)"

msgid "Account restored"
msgstr "Compte restauré"

msgid "Restore account"
msgstr "Restaurer le compte"

msgid "Restored the account."
msgstr "Le compte a été restauré."

msgid "Deleted the account; it is kept under the retention obligation."
msgstr "Le compte a été supprimé ; il est conservé en raison de l’obligation de conservation."

msgid "The account is deleted if no retention obligation applies. Otherwise it is kept as \"Deleted (retention obligation)\" and its email address becomes available for a new registration."
msgstr "Le compte est supprimé si aucune obligation de conservation ne s’applique. Sinon, il est conservé sous « Supprimé (obligation de conservation) » et son adresse e-mail redevient disponible pour une nouvelle inscription."

# Registration in three steps, result pages and the entry pages (D-058)
msgid "Your registration at %(instance_name)s"
msgstr "Votre inscription chez %(instance_name)s"

msgid "At least %(min_length)d characters."
msgstr "Au moins %(min_length)d caractères."

msgid "A sentence of several words is easy to remember and hard to guess."
msgstr "Une phrase de plusieurs mots est facile à retenir et difficile à deviner."

msgid "All characters are allowed; upper-case letters, digits and special characters are not required."
msgstr "Tous les caractères sont autorisés ; les majuscules, les chiffres et les caractères spéciaux ne sont pas exigés."

msgid "No known or easily guessed passwords, no number-only passwords."
msgstr "Pas de mots de passe connus ou faciles à deviner, pas de mots de passe composés uniquement de chiffres."

msgid "Not similar to your email address."
msgstr "Sans ressemblance avec votre adresse e-mail."

msgid "Email address (username)"
msgstr "Adresse e-mail (nom d’utilisateur)"

msgid "Repeat password"
msgstr "Répéter le mot de passe"

msgid "I have read the privacy notice and accept it."
msgstr "J’ai lu la déclaration de protection des données et je l’accepte."

msgid "I have read the <a href=\"%(url)s\" target=\"_blank\" rel=\"noopener noreferrer\">privacy notice</a> and accept it."
msgstr "J’ai lu la <a href=\"%(url)s\" target=\"_blank\" rel=\"noopener noreferrer\">déclaration de protection des données</a> et je l’accepte."

msgid "Please confirm that you accept the privacy notice."
msgstr "Veuillez confirmer que vous acceptez la déclaration de protection des données."

msgid "Enter your first name."
msgstr "Saisissez votre prénom."

msgid "Enter your last name."
msgstr "Saisissez votre nom."

msgid "Enter your street."
msgstr "Saisissez votre rue."

msgid "Postal code"
msgstr "Code postal"

msgid "My account"
msgstr "Mon compte"

msgid "Your details in the LEG portal."
msgstr "Vos informations dans le portail de la CEL."

msgid "Password rules"
msgstr "Règles pour les mots de passe"

msgid "Step %(step)s of 3"
msgstr "Étape %(step)s sur 3"

msgid ""
"Hello\n"
"\n"
"Please confirm your email address with this link. The link is valid for %(lifetime_hours)s hours.\n"
"\n"
"Continue registration:\n"
"\n"
"%(verification_url)s"
msgstr ""
"Bonjour\n"
"\n"
"Veuillez confirmer votre adresse e-mail avec ce lien. Le lien est valable %(lifetime_hours)s heures.\n"
"\n"
"Poursuivre l’inscription :\n"
"\n"
"%(verification_url)s"

msgid ""
"Hello\n"
"\n"
"There is already an account for this address. You can log in here. If you did not create an account, you can ignore this email.\n"
"\n"
"To the login:\n"
"\n"
"%(login_url)s\n"
"\n"
"If you do not know the password, you can request a new one on the login page."
msgstr ""
"Bonjour\n"
"\n"
"Il existe déjà un compte pour cette adresse. Vous pouvez vous connecter ici. Si vous n’avez pas créé de compte, vous pouvez ignorer cet e-mail.\n"
"\n"
"Vers la connexion :\n"
"\n"
"%(login_url)s\n"
"\n"
"Si vous ne connaissez pas le mot de passe, vous pouvez en demander un nouveau sur la page de connexion."

msgid "Confirm that <strong class=\"address-text\">%(email)s</strong> should become the email address for your account."
msgstr "Confirmez que <strong class=\"address-text\">%(email)s</strong> doit devenir l’adresse e-mail de votre compte."

msgid "Your new email address <strong class=\"address-text\">%(email)s</strong> is confirmed. From now on you sign in with this address."
msgstr "Votre nouvelle adresse e-mail <strong class=\"address-text\">%(email)s</strong> est confirmée. Désormais, vous vous connectez avec cette adresse."

msgid "To the login"
msgstr "Vers la connexion"

msgid "Link no longer valid"
msgstr "Lien devenu invalide"

msgid "Change stopped"
msgstr "Modification interrompue"

msgid "The change of your email address was stopped. Your previous addresses stay valid. All sessions of your account were ended."
msgstr "La modification de votre adresse e-mail a été interrompue. Vos adresses actuelles restent valides. Toutes les sessions de votre compte ont été terminées."

msgid "If you did not request the change, choose a new password now."
msgstr "Si vous n’êtes pas à l’origine de la modification, choisissez dès maintenant un nouveau mot de passe."

msgid "Choose a new password"
msgstr "Choisir un nouveau mot de passe"

msgid "Notification: second email address changed"
msgstr "Notification : seconde adresse e-mail modifiée"

msgid "The second email address at %(instance_name)s was changed"
msgstr "La seconde adresse e-mail chez %(instance_name)s a été modifiée"

msgid "The second email address for your account at %(instance_name)s was changed."
msgstr "La seconde adresse e-mail de votre compte chez %(instance_name)s a été modifiée."

msgid "Second address confirmed"
msgstr "Seconde adresse confirmée"

msgid "Your second email address <strong class=\"address-text\">%(email)s</strong> is confirmed. It receives information. You do not sign in with it."
msgstr "Votre seconde adresse e-mail <strong class=\"address-text\">%(email)s</strong> est confirmée. Elle reçoit des informations. Vous ne vous connectez pas avec elle."

msgid "We have sent an email to <strong class=\"address-text\">%(address)s</strong>. Please check your mailbox."
msgstr "Nous avons envoyé un e-mail à <strong class=\"address-text\">%(address)s</strong>. Veuillez vérifier votre boîte de réception."

msgid "We have sent an email. Please check your mailbox."
msgstr "Nous avons envoyé un e-mail. Veuillez vérifier votre boîte de réception."

msgid "No email received? It is worth looking in the spam folder."
msgstr "Pas d’e-mail reçu ? Jetez un coup d’œil dans le dossier des courriers indésirables."

msgid "Send email again"
msgstr "Renvoyer l’e-mail"

msgid "Sending again is possible after <span data-resend-seconds>%(seconds)s</span> seconds."
msgstr "Un nouvel envoi est possible dans <span data-resend-seconds>%(seconds)s</span> secondes."

msgid "Wrong address?"
msgstr "Mauvaise adresse ?"

msgid "Use another email address"
msgstr "Utiliser une autre adresse e-mail"

msgid "Login temporarily blocked"
msgstr "Connexion temporairement bloquée"

msgid "Code from the app"
msgstr "Code de l’application"

msgid "Do you not have the app at hand? Enter a recovery code."
msgstr "Vous n’avez pas l’application sous la main ? Saisissez un code de récupération."

msgid "Confirm"
msgstr "Confirmer"

msgid "Reset password"
msgstr "Réinitialiser le mot de passe"

msgid "We send you a link. It is valid for %(counter)s hour."
msgid_plural "We send you a link. It is valid for %(counter)s hours."
msgstr[0] "Nous vous envoyons un lien. Il est valable %(counter)s heure."
msgstr[1] "Nous vous envoyons un lien. Il est valable %(counter)s heures."
msgstr[2] "Nous vous envoyons un lien. Il est valable %(counter)s heures."

msgid "The link has expired or was already used. If you have already registered, go to the login. Otherwise request a new link."
msgstr "Le lien a expiré ou a déjà été utilisé. Si vous êtes déjà inscrit, connectez-vous. Sinon, demandez un nouveau lien."

msgid "The link has expired or was already used. If you have already chosen a new password, go to the login. Otherwise request a new link."
msgstr "Le lien a expiré ou a déjà été utilisé. Si vous avez déjà choisi un nouveau mot de passe, connectez-vous. Sinon, demandez un nouveau lien."

msgid "Send new link"
msgstr "Envoyer un nouveau lien"

msgid "You will sign in with this email address and this password."
msgstr "Vous vous connecterez désormais avec cette adresse e-mail et ce mot de passe."

msgid "Confirm email address"
msgstr "Confirmer l’adresse e-mail"

msgid "Already have an account?"
msgstr "Vous avez déjà un compte ?"

msgid "Your details"
msgstr "Vos informations personnelles"

msgid "Confirmed"
msgstr "Confirmée"

msgid "Set password"
msgstr "Définir le mot de passe"

# The profile in cards and the second address (D-059)
msgid "Personal link that stops the requested change of an email address."
msgstr "Lien personnel qui interrompt la modification demandée d’une adresse e-mail."

msgid "Greeting with the name of the person the account belongs to, or a neutral greeting if no suitable name is known. Best written on a line of its own at the start."
msgstr "Formule d’appel avec le nom de la personne à qui appartient le compte, ou formule neutre si aucun nom approprié n’est connu. De préférence sur une ligne distincte au début."

msgid "Neutral greeting without a name: the name of a deleted account is not kept. The preview and the test email show the same. Best written on a line of its own at the start."
msgstr "Formule d’appel neutre sans nom : le nom d’un compte supprimé n’est pas conservé. L’aperçu et l’e-mail de test affichent la même chose. De préférence sur une ligne distincte au début."

#: leg_platform/accounts/greeting.py
msgid "Hello"
msgstr "Bonjour"

#, python-format
msgid "Hello %(name)s"
msgstr "Bonjour %(name)s"

msgid "Confirm your second email address at %(instance_name)s"
msgstr "Confirmez votre seconde adresse e-mail chez %(instance_name)s"

msgid "An email address change was requested at %(instance_name)s"
msgstr "Une modification d’adresse e-mail a été demandée chez %(instance_name)s"

msgid "Your account at %(instance_name)s was deleted"
msgstr "Votre compte chez %(instance_name)s a été supprimé"

msgid "The password is not correct. Please try again."
msgstr "Le mot de passe est incorrect. Veuillez réessayer."

msgid "Email address for login (username)"
msgstr "Adresse e-mail de connexion (nom d’utilisateur)"

msgid "Second email address"
msgstr "Seconde adresse e-mail"

msgid "The second address receives information. You do not log in with it. Leave the field empty if you do not want one."
msgstr "La seconde adresse reçoit des informations. Vous ne vous connectez pas avec elle. Laissez le champ vide si vous n’en souhaitez pas."

msgid "You confirm new addresses with a link. The confirmation is valid for 24 hours. Otherwise the current address stays valid."
msgstr "Vous confirmez les nouvelles adresses par un lien. La confirmation est valable 24 heures. Sinon, l’adresse actuelle reste valide."

msgid "The second address must differ from the address for login."
msgstr "La seconde adresse doit être différente de l’adresse de connexion."

msgid "Nothing was changed."
msgstr "Rien n’a été modifié."

msgid "I know that my account and my details will be deleted and that this cannot be undone."
msgstr "Je sais que mon compte et mes informations seront supprimés et que cela ne peut pas être annulé."

msgid "second email address"
msgstr "seconde adresse e-mail"

msgid "Second email address: link to confirm the address"
msgstr "Seconde adresse e-mail : lien de confirmation de l’adresse"

msgid "Notification: email address change requested (with the link to stop it)"
msgstr "Notification : modification d’une adresse e-mail demandée (avec le lien pour l’interrompre)"

msgid "Notification: account deleted"
msgstr "Notification : compte supprimé"

msgid "Requested email address change cancelled by the account"
msgstr "Modification demandée d’une adresse e-mail annulée par le compte"

msgid "Requested email address change stopped with the link of the notice"
msgstr "Modification demandée d’une adresse e-mail interrompue avec le lien de la notification"

msgid "Second email address changed"
msgstr "Seconde adresse e-mail modifiée"

msgid "Saved."
msgstr "Enregistré."

msgid "We sent a confirmation link to the new address. It is valid for 24 hours."
msgstr "Nous avons envoyé un lien de confirmation à la nouvelle adresse. Il est valable 24 heures."

msgid "The request was cancelled."
msgstr "La demande a été annulée."

msgid "The recovery codes are saved."
msgstr "Les codes de récupération sont enregistrés."

msgid "Please confirm that you saved the codes. They are not shown again; if you did not save them, create new codes."
msgstr "Veuillez confirmer que vous avez enregistré les codes. Ils ne sont plus affichés ensuite ; si vous ne les avez pas enregistrés, créez de nouveaux codes."

msgid "Your account was deleted"
msgstr "Votre compte a été supprimé"

msgid "Your details are removed. You are logged out. If you want to take part again, you can register anew at any time."
msgstr "Vos informations ont été supprimées. Vous êtes déconnecté. Si vous souhaitez participer à nouveau, vous pouvez vous réinscrire à tout moment."

msgid "To the start page"
msgstr "Vers la page d’accueil"

msgid "Your account at %(instance_name)s and your personal details were deleted. Invoices and booking records are kept for as long as the law requires."
msgstr "Votre compte chez %(instance_name)s et vos données personnelles ont été supprimés. Les factures et les justificatifs comptables sont conservés aussi longtemps que la loi l’exige."

msgid ""
"A change of an email address was requested for your account at %(instance_name)s. Until the new address is confirmed, which is possible for %(lifetime_hours)s hours, your current addresses stay valid.\n"
"\n"
"Did you not request this change? Then click here to stop it at once:\n"
"\n"
"%(stop_url)s"
msgstr ""
"Une modification d’adresse e-mail a été demandée pour votre compte chez %(instance_name)s. Jusqu’à la confirmation de la nouvelle adresse, possible pendant %(lifetime_hours)s heures, vos adresses actuelles restent valides.\n"
"\n"
"Vous n’êtes pas à l’origine de cette modification ? Cliquez alors ici pour l’interrompre immédiatement :\n"
"\n"
"%(stop_url)s"

msgid "The email address for your account at %(instance_name)s was changed. You have to log in again."
msgstr "L’adresse e-mail de votre compte chez %(instance_name)s a été modifiée. Vous devez vous reconnecter."

msgid ""
"Hello\n"
"\n"
"Someone asked at %(instance_name)s to add this address as the second email address of an account. The second address only receives information; it is not used to log in. To confirm it, open this link:\n"
"\n"
"%(email_change_url)s\n"
"\n"
"The link expires in %(lifetime_hours)s hours. The address is not used until you confirm it. If you did not expect this, you can ignore this email; nothing will happen."
msgstr ""
"Bonjour\n"
"\n"
"Quelqu’un a demandé chez %(instance_name)s d’ajouter cette adresse comme seconde adresse e-mail d’un compte. La seconde adresse ne reçoit que des informations ; elle n’est pas utilisée pour se connecter. Pour la confirmer, ouvrez ce lien :\n"
"\n"
"%(email_change_url)s\n"
"\n"
"Le lien expire dans %(lifetime_hours)s heures. L’adresse n’est utilisée qu’après votre confirmation. Si vous ne vous y attendiez pas, vous pouvez ignorer cet e-mail ; il ne se passera rien."

msgid "Confirm second email address"
msgstr "Confirmer la seconde adresse e-mail"

msgid "Confirm that <strong class=\"address-text\">%(email)s</strong> should be the second email address of your account. It receives information. You do not log in with it."
msgstr "Confirmez que <strong class=\"address-text\">%(email)s</strong> doit être la seconde adresse e-mail de votre compte. Elle reçoit des informations. Vous ne vous connectez pas avec elle."

msgid "Confirm second address"
msgstr "Confirmer la seconde adresse"

msgid "This link can no longer be used. If you have just confirmed the change, log in with the new address."
msgstr "Ce lien ne peut plus être utilisé. Si vous venez de confirmer la modification, connectez-vous avec la nouvelle adresse."

msgid "Stop the change"
msgstr "Interrompre la modification"

msgid "A change of an email address of your account was requested. If you did not request it, stop it here. Your current addresses stay valid, and all sessions of your account end."
msgstr "Une modification d’une adresse e-mail de votre compte a été demandée. Si vous n’êtes pas à l’origine de cette demande, interrompez-la ici. Vos adresses actuelles restent valides et toutes les sessions de votre compte sont terminées."

msgid "Stop the change now"
msgstr "Interrompre la modification maintenant"

msgid "The link has expired or was already used. A change that was already confirmed cannot be stopped with it any more. Log in and check your details in the profile."
msgstr "Le lien a expiré ou a déjà été utilisé. Une modification déjà confirmée ne peut plus être interrompue avec ce lien. Connectez-vous et vérifiez vos informations dans le profil."

msgid "Your details and security settings."
msgstr "Vos informations et vos paramètres de sécurité."

msgid "Really delete the account?"
msgstr "Vraiment supprimer le compte ?"

msgid "With the deletion you lose access to the portal. Your personal details, your locations and your messages are deleted."
msgstr "En supprimant le compte, vous perdez l’accès au portail. Vos données personnelles, vos sites et vos messages sont supprimés."

msgid "Your details are deleted. We keep invoices and booking records for as long as the law requires. More in the <a href=\"%(url)s\" target=\"_blank\" rel=\"noopener noreferrer\">privacy notice</a>."
msgstr "Vos informations sont supprimées. Nous conservons les factures et les justificatifs comptables aussi longtemps que la loi l’exige. Plus d’informations dans la <a href=\"%(url)s\" target=\"_blank\" rel=\"noopener noreferrer\">déclaration de protection des données</a>."

msgid "Your details are deleted. We keep invoices and booking records for as long as the law requires. More in the privacy notice."
msgstr "Vos informations sont supprimées. Nous conservons les factures et les justificatifs comptables aussi longtemps que la loi l’exige. Plus d’informations dans la déclaration de protection des données."

msgid "Delete account permanently"
msgstr "Supprimer définitivement le compte"

msgid "Your account and your personal details are deleted. This cannot be undone."
msgstr "Votre compte et vos données personnelles sont supprimés. Cette action est irréversible."

