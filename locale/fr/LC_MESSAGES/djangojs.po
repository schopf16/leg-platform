#, javascript-format
msgid "Choose %s by selecting them and then select the \"Choose\" arrow button."
msgstr "Choisissez des %s en les sélectionnant, puis cliquez sur la flèche « Choisir »."

#, javascript-format
msgid "Remove %s by selecting them and then select the \"Remove\" arrow button."
msgstr "Retirez des %s en les sélectionnant, puis cliquez sur la flèche « Retirer »."

#, javascript-format
msgid "Choose all %s"
msgstr "Tout choisir (%s)"

#, javascript-format
msgid "Choose selected %s"
msgstr "Choisir la sélection (%s)"

#, javascript-format
msgid "Remove selected %s"
msgstr "Retirer la sélection (%s)"

#, javascript-format
msgid "Remove all %s"
msgstr "Tout retirer (%s)"

